# /etc/cbms/app.env - Configuration for Smart Catering Services (mode 0600)
# Managed by Ansible - DO NOT EDIT MANUALLY
SPRING_APPLICATION_NAME={{ app_name }}
SERVER_PORT={{ app_port }}

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://{{ db_host }}:{{ db_port }}/{{ db_name }}?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME={{ db_user }}
SPRING_DATASOURCE_PASSWORD={{ db_password }}

# Logging Configuration
LOGGING_FILE_PATH={{ log_dir }}
