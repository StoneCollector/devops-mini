pipeline {
    agent any

    tools {
        maven 'Maven 3.9.16'
        jdk 'JDK-21'
    }

    options {
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        SPRING_DATASOURCE_PASSWORD = credentials('cbms-db-password')
        DOCKER_DB_PASSWORD = credentials('cbms-docker-db-password')
        IMAGE_TAG = "1.2.${BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                echo '==> Stage: Checking out code from SCM...'
                checkout scm
            }
        }

        stage('Build and Unit Tests') {
            steps {
                echo '==> Stage: Compiling source code and executing unit test suite...'
                bat 'mvn clean test'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }

        stage('Selenium Integration Tests') {
            steps {
                echo '==> Stage: Executing Selenium WebDriver integration tests in headless mode...'
                bat 'mvn verify -Dheadless=true'
            }
            post {
                always {
                    junit 'target/failsafe-reports/*.xml'
                }
            }
        }

        stage('Docker Build') {
            when {
                expression { currentBuild.currentResult == 'SUCCESS' }
            }
            steps {
                echo "==> Stage: Building Docker image (${IMAGE_TAG} and latest)..."
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    bat 'docker build -t %DOCKER_USER%/cbms:%IMAGE_TAG% -t %DOCKER_USER%/cbms:latest .'
                }
            }
        }

        stage('Docker Push') {
            when {
                expression { currentBuild.currentResult == 'SUCCESS' }
            }
            steps {
                echo "==> Stage: Authenticating and pushing images to Docker Hub..."
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    bat '@echo off & echo %DOCKER_PASS%| docker login -u %DOCKER_USER% --password-stdin'
                    bat 'docker push %DOCKER_USER%/cbms:%IMAGE_TAG%'
                    bat 'docker push %DOCKER_USER%/cbms:latest'
                    bat 'docker logout'
                }
            }
        }

        stage('Deploy Container') {
            when {
                expression { currentBuild.currentResult == 'SUCCESS' }
            }
            steps {
                echo "==> Stage: Deploying cbms-app container with tag ${IMAGE_TAG}..."
                withCredentials([usernamePassword(credentialsId: 'dockerhub-creds', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    bat '''
                        @echo off
                        if exist "current-tag.txt" (
                            copy /Y current-tag.txt previous-tag.txt
                        )
                        echo %IMAGE_TAG%> current-tag.txt
                    '''
                    bat(returnStatus: true, script: 'docker rm -f cbms-app')
                    bat "docker run -d --name cbms-app --network cbms-net -p 8082:8082 -e SPRING_DATASOURCE_URL=\"jdbc:mysql://cbms-db:3306/cbms_db?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false\" -e SPRING_DATASOURCE_USERNAME=root -e SPRING_DATASOURCE_PASSWORD=%DOCKER_DB_PASSWORD% %DOCKER_USER%/cbms:%IMAGE_TAG%"
                }
            }
        }

        stage('Smoke Test') {
            when {
                expression { currentBuild.currentResult == 'SUCCESS' }
            }
            steps {
                echo '==> Stage: Verifying container health via HTTP smoke test...'
                script {
                    def healthy = false
                    for (int i = 1; i <= 8; i++) {
                        sleep(time: 5, unit: 'SECONDS')
                        def status = bat(returnStatus: true, script: '@echo off & curl -f -s -o nul http://localhost:8082')
                        if (status == 0) {
                            echo "==> Smoke test PASSED: Application is responding at http://localhost:8082"
                            healthy = true
                            break
                        }
                        echo "Still waiting for container to start... (attempt ${i}/8)"
                    }
                    if (!healthy) {
                        bat 'docker logs cbms-app'
                        error("Smoke test FAILED: Container failed to respond after 40 seconds.")
                    }
                }
            }
        }
    }

    post {
        always {
            bat(returnStatus: true, script: 'mvn surefire-report:failsafe-report-only')
            publishHTML(target: [
                reportDir: 'target/site',
                reportFiles: 'failsafe-report.html',
                reportName: 'Selenium Failsafe Report',
                keepAll: true,
                allowMissing: true,
                alwaysLinkToLastBuild: true
            ])
            archiveArtifacts artifacts: 'target/screenshots/*.png, current-tag.txt, previous-tag.txt', allowEmptyArchive: true
        }
        failure {
            echo '=========================================================================='
            echo ' PIPELINE FAILURE: Deployment was skipped because one or more tests failed.'
            echo '=========================================================================='
        }
    }
}
